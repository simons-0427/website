# ============================================================
# 1. HTTPS + www -> non-www (eine 301-Weiterleitung, kanonisch)
# ============================================================
RewriteEngine on

# a) auf HTTPS erzwingen  b) www entfernen
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://smstark-projekt.de%{REQUEST_URI} [L,R=301]

# ============================================================
# 2. Bestehende Regel: .html-Endung verstecken (unverändert)
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# ============================================================
# 3. GZip-Komprimierung (mod_deflate)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    text/javascript application/javascript application/x-javascript \
    application/json application/xml image/svg+xml
</IfModule>

# ============================================================
# 4. HTTP-Header haerten
# ============================================================
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
