# ============================================================
# 1. HTTPS + www -> non-www
# ============================================================
RewriteEngine on

# Bingo-Subdomain: kein HTTPS erzwingen (Zertifikat fehlt noch).
# Nicht auf die Hauptdomain umleiten.
RewriteCond %{HTTP_HOST} ^bingo\.smstark-projekt\.de$ [NC]
RewriteCond %{REQUEST_URI} !^/bingo/
RewriteRule ^(.*)$ /bingo/$1 [L]

# HTTPS erzwingen und www entfernen (Hauptdomain, nicht Bingo-Subdomain)
RewriteCond %{HTTP_HOST} !^bingo\.smstark-projekt\.de$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://smstark-projekt.de%{REQUEST_URI} [L,R=301,NE]

# ============================================================
# 2. Kanonische URLs und alte Upload-Pfade
# ============================================================

# Apache darf extensionless URLs nicht über MultiViews vorzeitig auflösen.
Options -MultiViews

# Root- und Verzeichnis-Indexdateien nicht als separate URLs ausliefern.
# THE_REQUEST stellt sicher, dass nur echte Browser-Aufrufe umgeleitet werden
# und keine interne Auflösung einer extensionless URL in eine Redirect-Schleife läuft.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Veraltete oder leere Routen bewusst auf passende aktive Seiten fuehren
RewriteRule ^weltmarkt/?$ /dashboards/weltmarkt/ [R=301,L,NE]
RewriteRule ^projekte/downloads/?$ /downloads [R=301,L,NE]
RewriteRule ^dashboards/weltmarkt/projekte\.html$ /projekte/ [R=301,L,NE]
RewriteRule ^dashboards/downloads/?$ /downloads [R=301,L,NE]
RewriteRule ^dashboards/projekte/?$ /projekte/ [R=301,L,NE]
RewriteRule ^dashboards/projekt-pipeline/?$ /projekt-pipeline [R=301,L,NE]
RewriteRule ^dashboards/Vision/?$ /vision [R=301,L,NE,NC]
RewriteRule ^dashboards/backtester/backtester(?:\.html)?$ /dashboards/backtester/ [R=301,L,NE]
RewriteRule ^dashboards/bitcoin/bitcoin(?:\.html)?$ /dashboards/backtester/ [R=301,L,NE]

# Direkte .html-Aufrufe auf die kanonische extensionless URL umleiten.
# Die Datei bleibt auf dem Server bestehen; nur die öffentliche URL ändert sich.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L,NE]

# ============================================================
# 3. Interne Regel: extensionless URL auf die Serverdatei aufloesen
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [NC,L]

# ============================================================
# 4. GZip-Komprimierung (mod_deflate)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    text/javascript application/javascript application/x-javascript \
    application/json application/xml image/svg+xml
</IfModule>

# ============================================================
# 5. HTTP-Header haerten
# ============================================================
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
</IfModule>

# ============================================================
# 6. Cache fuer statische Assets und HTML
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|json|xml|svg|png|jpe?g|gif|webp|avif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:html?|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
